# @capacitor-community/stripe 8.1.1 declares peers it doesn't actually need for
# the way we use it — @stripe/stripe-js ^8 (we're on 9, for the web
# PaymentElement) and react ^17||^18 (we're on 19). Only its NATIVE iOS bridge
# is used, via a lazy import that never reaches the web bundle, so the strict
# peer resolution npm 7+ applies would block an install that works fine.
#
# Without this, `npm ci` fails with ERESOLVE — locally and on Vercel.
legacy-peer-deps=true
