# Production build — loaded automatically by `vite build` (Vercel runs this).
# ---------------------------------------------------------------------------
# Point the app at the deployed backend. VERIFY this matches your backend's
# Vercel domain (Vercel → narsil-museum-backend → Settings → Domains).
VITE_API_URL=https://narsil-museum-backend.vercel.app

# NOTE: Supabase keys are NOT committed here. Set these in the Vercel dashboard
# (museum-app → Settings → Environment Variables) so the production build can
# read them:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
