# Copy this file to `.env.local` for local development (it's gitignored).
# ---------------------------------------------------------------------------

# Supabase — client-safe publishable ("anon") key. Required for auth + sync.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Backend base URL.
#   Local dev: leave unset (defaults to http://localhost:4000).
#   Production: set in .env.production or the Vercel dashboard.
# VITE_API_URL=http://localhost:4000

# Stripe publishable key (pk_test_… / pk_live_…) — client-safe. Canvas
# checkout stays hidden behind a "payments unavailable" notice while unset.
# Must match the mode of the backend's STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=

# Apple Pay merchant id — created in the Apple Developer portal and registered
# with Stripe (Settings → Payment methods → Apple Pay). Enables the Apple Pay
# button in the native iOS payment sheet. Card entry still works while unset.
VITE_APPLE_PAY_MERCHANT_ID=merchant.com.narsil.museum

# Support inbox address used by Profile → Contact admin (mailto).
# VITE_SUPPORT_EMAIL=support@narsil.app
