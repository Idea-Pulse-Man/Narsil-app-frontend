# Copy this file to `.env.local` for local development (it's gitignored).
# ---------------------------------------------------------------------------

# Supabase — client-safe publishable ("anon") key. Required for auth + sync.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Backend base URL.
#   Local dev: leave unset (defaults to http://localhost:4000).
#   Production: set in .env.production or the Vercel dashboard.
# VITE_API_URL=http://localhost:4000
